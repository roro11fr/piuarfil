# Conexiunea la baza de date Supabase: Project Settings → Database → Connection string
# Pentru Vercel folosește „Transaction pooler” (portul 6543).
DATABASE_URL=postgresql://postgres.xxxx:PAROLA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Șir aleator de minim 32 de caractere (ex. rezultatul comenzii: openssl rand -base64 48)
SESSION_SECRET=

# Adresa publică a site-ului, folosită în linkurile personale ale pacienților
PUBLIC_URL=https://programari.piuarfil.ro

# Telefonul recepției, afișat pe site și în mesaje
CLINIC_PHONE=0752 192 733

# Opțional: email automat către pacienții care își lasă adresa (resend.com)
RESEND_API_KEY=
EMAIL_FROM=Piuarfil <programari@piuarfil.ro>
